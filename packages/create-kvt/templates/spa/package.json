    "react-router": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@kvt/eslint-plugin": "__KVT_VERSION__",
    "@playwright/test": "^1.54.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
