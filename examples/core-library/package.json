{
  "name": "@kvt/example-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kvt/core": "1.0.0",
    "@kvt/flow": "1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kvt/eslint-plugin": "1.0.0",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.8.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
