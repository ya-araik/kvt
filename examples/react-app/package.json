{
  "name": "@kvt/example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node server/prepare-db.mjs && json-server server/.data/db.json --port 4174",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "server:reset": "node server/prepare-db.mjs --reset",
    "server:sync-seed": "node server/sync-seed.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kvt/core": "1.0.0",
    "@kvt/devtools-protocol": "1.0.0",
    "@kvt/devtools-react": "1.0.0",
    "@kvt/flow": "1.0.0",
    "@kvt/react": "1.0.0",
    "@kvt/router-react": "1.0.0",
    "@kvt/theme-core": "1.0.0",
    "@kvt/theme-react": "1.0.0",
    "@kvt/theme-tailwind": "1.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.33.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@kvt/eslint-plugin": "1.0.0",
    "@kvt/testing": "1.0.0",
    "@kvt/testing-react": "1.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.0.0",
    "jsdom": "^29.0.0",
    "json-server": "1.0.0-beta.15",
    "prettier": "^3.8.0",
    "tailwindcss": "^4.3.1",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.0"
  }
}
